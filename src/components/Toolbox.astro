---
// Toolbox as groups of icon tiles. Icons come from the simple-icons package and
// are inlined as SVG at build time, so nothing loads from a CDN.
import * as icons from "simple-icons";
import { toolbox } from "../data/site";

type SimpleIcon = { path: string; hex: string; title: string };

function lookup(slug?: string): SimpleIcon | undefined {
  if (!slug) return undefined;
  const key = "si" + slug.charAt(0).toUpperCase() + slug.slice(1);
  return (icons as unknown as Record<string, SimpleIcon>)[key];
}

// Brand colour on hover, unless it is too dark or too light to read on our backgrounds.
function hoverColour(hex: string): string | undefined {
  const [r, g, b] = [0, 2, 4].map((i) => parseInt(hex.slice(i, i + 2), 16) / 255);
  const lum = 0.2126 * r + 0.7152 * g + 0.0722 * b;
  return lum > 0.12 && lum < 0.8 ? `#${hex}` : undefined;
}
---

<div class="toolbox">
  {
    toolbox.map((group) => (
      <div class="group">
        <h3 class="label">{group.area}</h3>
        <ul>
          {group.items.map((item) => {
            const icon = lookup(item.icon);
            const brand = icon ? hoverColour(icon.hex) : undefined;
            return (
              <li style={brand ? `--brand: ${brand}` : undefined}>
                {icon ? (
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d={icon.path} />
                  </svg>
                ) : (
                  <span class="badge" aria-hidden="true">
                    {item.name.slice(0, 3).toLowerCase()}
                  </span>
                )}
                <span>{item.name}</span>
              </li>
            );
          })}
        </ul>
      </div>
    ))
  }
</div>

<style>
  .toolbox {
    display: grid;
    gap: var(--s6);
  }
  .group h3 {
    margin-bottom: var(--s3);
  }
  ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: var(--s2);
  }
  li {
    display: flex;
    align-items: center;
    gap: var(--s3);
    min-height: 48px;
    padding: var(--s3) var(--s4);
    border: 1px solid var(--line);
    border-radius: var(--r2);
    background: var(--surface);
    font-size: 0.875rem;
    line-height: 1.3;
    color: var(--ink);
    transition:
      border-color 150ms,
      color 150ms;
  }
  svg {
    flex: none;
    width: 18px;
    height: 18px;
    fill: var(--muted);
    transition: fill 150ms;
  }
  li:hover {
    border-color: var(--muted);
  }
  li:hover svg {
    fill: var(--brand, var(--ink));
  }
  .badge {
    flex: none;
    width: 18px;
    font-family: var(--mono);
    font-size: 0.5625rem;
    font-weight: 600;
    line-height: 18px;
    text-align: center;
    letter-spacing: -0.02em;
    color: var(--muted);
  }
  @media (max-width: 640px) {
    ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    li {
      padding: var(--s3);
      gap: var(--s2);
    }
  }
</style>
