---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found">
  <section class="wrap" style="padding-block: var(--s9)">
    <p class="label">404</p>
    <h1 style="margin-top: var(--s5)">That page doesn't exist.</h1>
    <p class="lead" style="margin-top: var(--s5)">The link may be old, or the address may have a typo.</p>
    <div class="actions" style="margin-top: var(--s6)">
      <a class="btn btn-primary" href="/">Go to the home page</a>
      <a class="btn" href="/projects">See all projects</a>
    </div>
  </section>
</Base>
